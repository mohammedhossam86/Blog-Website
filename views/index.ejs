<div class="auther">
    <h1 class="Aauthor__heading"> Hi, I am Hossam</h1>
    <p class="author__body"> Backend Developer </p>

</div>

<img src="/images/hero-image.webp" alt="" class="hero-image" width="981" height="528">

<section class="articles">
    <h2 class="articles__heading"> Latest Posts </h2>
    <ul class="article-ul">
        <% posts.forEach(Post => { %>
         
            <li>
                <a href="/posts/<%= Post._id%>">
                    <span><%=Post.title%></span>
                    <span class="article-list__date"><%=Post.updatedAt.toDateString()%></span>
                </a>
            </li>
        <% }) %>
    </ul>
    <% if (nextPage !== null) { %>
    <a href="/?page=<%= nextPage %>" class="pagination">&lt; View Older Posts</a>
  <% } %>
</section>